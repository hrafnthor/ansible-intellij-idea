{
    "title": "intellij",
    "description": "Schema for IntelliJ IDEA installation",
    "type": "object",
    "properties":
    {
        "location":
        {
            "type": "object",
            "properties":
            {
                "path":
                {
                    "$ref": "#/definitions/non-empty-string"
                },
                "owner":
                {
                    "$ref": "#/definitions/non-empty-string"
                },
                "group":
                {
                    "$ref": "#/definitions/non-empty-string"
                },
                "mode":
                {
                    "ref": "#/definitions/non-empty-string"
                }
            }
        },
        "clients":
        {
            "type": "array",
            "items":
            {
                "type": "object",
                "properties":
                {
                    "version":
                    {
                        "$ref": "#/definitions/non-empty-string"
                    },
                    "checksum":
                    {
                        "$ref": "#/definitions/non-empty-string"
                    },
                    "desktop":
                    {
                        "type": "object",
                        "properties":
                        {
                            "name":
                            {
                                "$ref": "#/definitions/non-empty-string"
                            },
                            "keywords":
                            {
                                "$ref": "#/definitions/non-empty-string-array"
                            },
                            "remove":
                            {
                                "type": "boolean"
                            }
                        }
                    },
                    "remove":
                    {
                        "type": "boolean"
                    }
                },
                "required":
                [
                    "version"
                ]
            },
            "if":
            {
                "properties":
                {
                    "remove":
                    {
                        "const": false
                    }
                }
            },
            "then":
            {
                "required":
                [
                    "version",
                    "checksum"
                ]
            }
        }
    },
    "definitions":
    {
        "non-empty-string":
        {
            "type": "string",
            "minLength": 1
        },
        "non-empty-string-array":
        {
            "type": "array",
            "minItems": 1,
            "items":
            {
                "$ref": "#/definitions/non-empty-string"
            }
        }
    }
}
